@@ -1029,7 +1029,20 @@ class OrchestrationStmtCodegen : public CodegenBase {
         slot_expr = "((" + loop_var + " - " + start_expr + ") / " + step_expr + ")";
       }
       current_loop_slot_exprs_.push_back(slot_expr);
+      // A Parallel loop states that its iterations are independent, which is what a
+      // task group declares: a member's producers are tasks of that same iteration
+      // or work already retired. Whether an iteration also holds an edge of its own
+      // -- the thing a controller can resolve -- depends on what the body submits,
+      // and is decided where the graph is built; a declaration that holds none is
+      // dropped there. A runtime without grouping ignores the pair.
+      const bool declares_group = for_stmt->kind_ == ForKind::Parallel;
+      if (declares_group) {
+        EmitIndentedLine("rt_group_begin();");
+      }
       VisitStmt(for_stmt->body_);
+      if (declares_group) {
+        EmitIndentedLine("rt_group_end();");
+      }
       current_loop_slot_exprs_.pop_back();
       current_return_vars_ = saved;
 
